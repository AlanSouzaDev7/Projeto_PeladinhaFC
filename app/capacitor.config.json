{
  "appId": "io.github.alansouzadev7.futebol",
  "appName": "433Fut",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "minWebViewVersion": 111,
    "errorPath": "atualizar.html"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1800,
      "backgroundColor": "#0B0B0D",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
