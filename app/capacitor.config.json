{
  "appId": "io.github.alansouzadev7.futebol",
  "appName": "CazéStats.TV",
  "webDir": "www",
  "server": {
    "url": "https://cazestats.pages.dev/",
    "androidScheme": "https",
    "errorPath": "sem-conexao.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "minWebViewVersion": 111,
    "appendUserAgent": "CazeStatsApp/3.0.0"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1800,
      "backgroundColor": "#0B0B0D",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
